# Copie para ".env" e ajuste.

# Porta do servidor (Render/Railway/Fly definem PORT sozinhos)
PORT=3000

# Senha de acesso ao sistema inteiro (HTTP Basic). OBRIGATÓRIA em produção.
# O navegador pede usuário/senha uma vez; depois cada pessoa entra com o login próprio do sistema.
APP_USUARIO=fluxo
APP_SENHA=troque-esta-senha

# Pasta do banco (fluxo.db) e dos anexos. Em produção, aponte para um disco/volume persistente.
PASTA_DADOS=./data

# Pasta onde "npm run backup" grava as cópias
PASTA_BACKUPS=./backups

# Tamanho máximo de cada anexo enviado
LIMITE_ANEXO=30mb

# NODE_ENV=production
